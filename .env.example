APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Prometheus metrics at /metrics (requires pip install '.[observability]')
METRICS_ENABLED=true
MCP_HOST=0.0.0.0
MCP_PORT=8001

# mock: runs without external middleware; mcp: calls the FastMCP service
TOOL_BACKEND=mock
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_SERVICE_TOKEN=change-me

# Storage implementation. mock: runs without external middleware.
# postgres: real SQL metrics + RLS. RAG/graph have their own backends below.
DATA_BACKEND=mock

DATABASE_URL=postgresql+asyncpg://sales_agent:sales_agent@localhost:5432/sales_agent
LANGGRAPH_DATABASE_URL=postgresql://sales_agent:sales_agent@localhost:5432/sales_agent
CHECKPOINTER_BACKEND=memory
MEMORY_BACKEND=memory
AUDIT_BACKEND=log
LANGGRAPH_STRICT_MSGPACK=true
REDIS_URL=redis://localhost:6379/0
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
RAG_BACKEND=mock
RAG_COLLECTION_NAME=sales_document_chunks
RAG_EMBEDDING_DIM=1024
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=160
RAG_RETRIEVAL_TOP_K=20
RAG_RERANK_TOP_K=5
# BGE reranker normalized-score refusal threshold; tune using evaluations/rag/golden.jsonl
RAG_MIN_SCORE=0.35
# Used only when reranker is disabled; RRF/BM25 scores are not calibrated like reranker scores.
RAG_MIN_RETRIEVAL_SCORE=0.0
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=16
RAG_ENABLE_RERANKER=true
NEBULA_HOST=localhost
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=sales_graph
# mock: simulated relationship paths; nebula: real NebulaGraph (see deploy/nebula/init.ngql)
GRAPH_BACKEND=mock

JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_AUDIENCE=sales-agent
ALLOW_DEV_TOKEN=true

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai_compatible
LLM_API_STYLE=chat_completions
LLM_REASONING_BACKEND=rules
# rules | llm | laya. Laya is optional and should be calibrated on your intent test set.
INTENT_ROUTER_BACKEND=rules
INTENT_CONFIDENCE_THRESHOLD=0.65
LAYA_DEVICE=cpu
LAYA_PRELOAD=false
# auto routes Chinese/non-Latin input to the multilingual checkpoint.
LAYA_MODEL=auto
LLM_ROUTER_MODEL=
LLM_SYNTHESIS_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=2
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_SECONDS=30
LLM_MAX_CONCURRENCY=8
LLM_BULKHEAD_WAIT_SECONDS=0.1
LLM_RETRY_BASE_DELAY_SECONDS=0.25
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

SESSION_MEMORY_TTL_SECONDS=86400
MEMORY_TOKEN_BUDGET=1800
MAX_TOOL_ITERATIONS=3
LLM_BUDGET_TOKENS=12000
PROMPT_CATALOG_PATH=./config/prompts.json
PROMPT_DEFAULT_LOCALE=zh-CN
EXPORT_DIR=./exports
# mock: simulated export task; xlsx: real file export (openpyxl, falls back to CSV)
EXPORT_BACKEND=mock
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_COMMAND_TIMEOUT_SECONDS=15
TOOL_TIMEOUT_SECONDS=20
TOOL_MAX_RETRIES=1
TOOL_RETRY_BASE_DELAY_SECONDS=0.2
TOOL_CIRCUIT_FAILURE_THRESHOLD=5
TOOL_CIRCUIT_RECOVERY_SECONDS=30
TOOL_MAX_CONCURRENCY=20
TOOL_BULKHEAD_WAIT_SECONDS=0.1
API_REQUEST_TIMEOUT_SECONDS=90
API_RATE_LIMIT_BACKEND=memory
API_RATE_LIMIT_REDIS_PREFIX=sales-agent:admission
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_CONCURRENT_PER_USER=4
API_CONCURRENCY_WAIT_SECONDS=0.1
INGESTION_MAX_FILE_BYTES=20000000
INGESTION_QUEUE_CAPACITY=100
# memory: local development; redis_stream: PostgreSQL payload/state + Redis consumer group
INGESTION_BACKEND=memory
INGESTION_STREAM_NAME=sales-agent:document-ingestion
INGESTION_CONSUMER_GROUP=sales-agent-indexers
INGESTION_MAX_ATTEMPTS=3
INGESTION_CLAIM_IDLE_SECONDS=300
INGESTION_POLL_BLOCK_MS=1000
INGESTION_CLEANUP_INTERVAL_SECONDS=3600
INGESTION_FAILED_PAYLOAD_RETENTION_DAYS=7
INGESTION_JOB_RETENTION_DAYS=90
